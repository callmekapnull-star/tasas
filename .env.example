# ============================================================
#  .env.example
#  Plantilla de variables de entorno para desarrollo LOCAL.
#
#  Cómo usarlo:
#    1. Copia este archivo como ".env" en la raíz del proyecto.
#    2. Rellena cada valor con los datos reales.
#    3. Nunca subas el .env a Git (ya está en .gitignore).
#
#  En Render, estas variables se configuran en el dashboard,
#  NO en este archivo.
# ============================================================


# ============================================================
#  TELEGRAM
# ============================================================

# aqui va el token del bot de Telegram (lo da @BotFather)
# Formato: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=

# aqui va el ID numérico del admin inicial (lo da @userinfobot)
# Solo se usa en el primer arranque, después se gestiona desde el bot
# con /addadmin y /deladmin.
ADMIN_ID=

# aqui va el canal inicial de Telegram donde el bot publica
# Solo se usa en el primer arranque, después se cambia desde el bot
# con /canal @nuevo
CANAL=@BancaYDivisaVe

# aqui va la URL pública del bot (se usa para configurar el webhook)
# - En LOCAL: puedes dejarla vacía y usar polling manual
# - En RENDER: la pones DESPUÉS del primer deploy
WEBHOOK_URL=


# ============================================================
#  BASE DE DATOS (PostgreSQL)
# ============================================================

# aqui va la URL de conexión a PostgreSQL
#
# Local (docker o postgres instalado):
#   postgresql://usuario:password@localhost:5432/tasas
#
# Render (Internal Database URL):
#   La inyecta automáticamente con fromDatabase en render.yaml
#   Formato: postgresql://banca_user:xxxxx@dpg-xxxxx-a.oregon-postgres.render.com/tasas
#
# Neon / Supabase (alternativas gratuitas):
#   postgresql://usuario:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/tasas


# ============================================================
#  MICROSERVICIO DE TASAS
# ============================================================

# aqui va la URL del microservicio de tasas (Binance P2P)
#
# Local (ambos servicios en tu PC):
#   http://127.0.0.1:8000/rates
#
# Render (red interna, recomendado):
#   http://tasas:8000/rates        ← usa el nombre de tu servicio
#
# Render (URL pública, más lento):
#   https://tasas-xxxx.onrender.com/rates
RATES_SERVICE_URL=http://127.0.0.1:8000/rates


# ============================================================
#  SERVIDOR
# ============================================================

# aqui va el puerto donde escucha FastAPI
# - En LOCAL: 8000
# - En RENDER: lo asigna automáticamente con $PORT
PORT=8000