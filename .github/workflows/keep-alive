# .github/workflows/keep-alive.yml
name: Keep Render App Alive

on:
  schedule:
    # Se ejecuta cada 10 minutos. El intervalo mínimo en GitHub Actions es de 5 min.
    - cron: '*/10 * * * *'
  workflow_dispatch: # Permite ejecutarlo manualmente desde la pestaña "Actions".

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Ping Render Service
        run: curl -fsS https://bot-njfn.onrender.com/keep-alive
